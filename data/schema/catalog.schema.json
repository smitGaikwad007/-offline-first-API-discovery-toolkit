{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API catalog snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "generatedAt", "categories", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nullableUri": {
      "anyOf": [
        { "type": "string", "format": "uri" },
        { "type": "null" }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceUrl", "verifiedAt", "notes"],
      "properties": {
        "status": { "enum": ["verified", "observed", "unverified", "unknown"] },
        "sourceUrl": { "$ref": "#/$defs/nullableUri" },
        "verifiedAt": {
          "anyOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        },
        "notes": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["verified", "observed"] } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "sourceUrl": { "type": "string", "format": "uri" },
              "verifiedAt": { "type": "string", "format": "date" }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "provider", "description", "category", "websiteUrl",
        "documentationUrl", "authentication", "pricing", "https", "cors", "corsCheck",
        "rateLimits", "tags", "protocols", "supportedLanguages", "dataSource",
        "lastVerifiedAt", "fieldEvidence", "examples", "specifications", "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/id" },
        "websiteUrl": { "$ref": "#/$defs/nullableUri" },
        "documentationUrl": { "$ref": "#/$defs/nullableUri" },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "methods", "notes"],
          "properties": {
            "required": { "enum": [true, false, "unknown"] },
            "methods": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["apiKey", "oauth2", "httpBasic", "httpBearer", "mutualTLS", "other"] }
            },
            "notes": { "type": ["string", "null"] }
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "notes"],
          "properties": {
            "model": { "enum": ["free", "freemium", "paid", "usage_based", "quote", "unknown"] },
            "notes": { "type": ["string", "null"] }
          }
        },
        "https": { "type": ["boolean", "null"] },
        "cors": { "type": ["boolean", "null"] },
        "corsCheck": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["checkedOrigin", "checkedAt", "result"],
              "properties": {
                "checkedOrigin": { "type": "string", "format": "uri" },
                "checkedAt": { "type": "string", "format": "date" },
                "result": { "type": "boolean" }
              }
            }
          ]
        },
        "rateLimits": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["limits", "notes"],
              "properties": {
                "limits": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["quantity", "unit", "period", "scope"],
                    "properties": {
                      "quantity": { "type": "number", "exclusiveMinimum": 0 },
                      "unit": { "type": "string", "minLength": 1 },
                      "period": { "type": "string", "minLength": 1 },
                      "scope": { "type": "string", "minLength": 1 }
                    }
                  }
                },
                "notes": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "protocols": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "supportedLanguages": {
          "anyOf": [
            { "type": "null" },
            { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "dataSource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "url", "accessedAt", "licenseStatus", "licenseName", "attribution"],
          "properties": {
            "type": { "enum": ["official_documentation", "official_catalog", "official_specification", "community_directory", "other"] },
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" },
            "accessedAt": { "type": "string", "format": "date" },
            "licenseStatus": { "enum": ["reviewed", "not_assessed", "unknown"] },
            "licenseName": { "type": ["string", "null"] },
            "attribution": { "type": ["string", "null"] }
          }
        },
        "lastVerifiedAt": {
          "anyOf": [
            { "type": "string", "format": "date" },
            { "type": "null" }
          ]
        },
        "fieldEvidence": {
          "type": "object",
          "minProperties": 1,
          "required": [
            "description",
            "authentication.required",
            "pricing",
            "https",
            "cors",
            "rateLimits",
            "supportedLanguages"
          ],
          "properties": {
            "description": { "$ref": "#/$defs/evidence" },
            "authentication.required": { "$ref": "#/$defs/evidence" },
            "pricing": { "$ref": "#/$defs/evidence" },
            "https": { "$ref": "#/$defs/evidence" },
            "cors": { "$ref": "#/$defs/evidence" },
            "rateLimits": { "$ref": "#/$defs/evidence" },
            "supportedLanguages": { "$ref": "#/$defs/evidence" }
          },
          "additionalProperties": { "$ref": "#/$defs/evidence" }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "kind", "sourceUrl", "verifiedAt"],
            "properties": {
              "language": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["official", "curated", "generated"] },
              "sourceUrl": { "type": "string", "format": "uri" },
              "verifiedAt": { "type": "string", "format": "date" }
            }
          }
        },
        "specifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "version", "url", "verifiedAt"],
            "properties": {
              "format": { "type": "string", "minLength": 1 },
              "version": { "type": ["string", "null"] },
              "url": { "type": "string", "format": "uri" },
              "verifiedAt": { "type": "string", "format": "date" }
            }
          }
        },
        "status": { "enum": ["active", "deprecated", "sunset", "unknown"] }
      },
      "allOf": [
        {
          "if": { "properties": { "cors": { "enum": [true, false] } }, "required": ["cors"] },
          "then": { "properties": { "corsCheck": { "type": "object" } } }
        },
        {
          "if": { "properties": { "cors": { "type": "null" } }, "required": ["cors"] },
          "then": { "properties": { "corsCheck": { "type": "null" } } }
        }
      ]
    }
  }
}
